#!/bin/bash

# Extract translatable strings from the .glade files without intltool-extract,
# which is not available everywhere.
python3 - <<'EOF'
import html
import re
import sys

GLADE_FILES = ("resources/mintinstall.glade", "resources/package-tile.glade")
PROPS = ("label", "tooltip-text", "placeholder-text", "title", "text")

def escape(value):
    return (value.replace("\\", "\\\\")
                 .replace('"', '\\"')
                 .replace("\n", "\\n")
                 .replace("\t", "\\t"))

for glade in GLADE_FILES:
    with open(glade, encoding="utf-8") as stream:
        text = stream.read()

    out = open(glade + ".h", "w", encoding="utf-8")
    for match in re.finditer(r'<property name="([a-z-]+)"([^>]*)>(.*?)</property>',
                             text, re.S):
        prop, attrs, value = match.group(1), match.group(2), match.group(3)
        if prop not in PROPS or 'translatable="yes"' not in attrs:
            continue
        value = html.unescape(value).strip()
        if not value:
            continue
        line = text.count("\n", 0, match.start(3)) + 1
        out.write('#: %s:%d\nN_("%s")\n' % (glade, line, escape(value)))
    out.close()
EOF

xgettext --language=Python -cTRANSLATORS --keyword=_ --keyword=N_ --output=mintinstall.pot  \
    usr/lib/linuxmint/mintinstall/*.py                                       \
    generate_desktop_files                                                   \
    resources/mintinstall.glade.h                                            \
    resources/package-tile.glade.h

rm -f resources/mintinstall.glade.h resources/package-tile.glade.h
